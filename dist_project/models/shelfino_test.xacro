<?xml version='1.0' ?>
<robot name='shelfino' xmlns:xacro='http://www.ros.org/wiki/xacro'>

  <xacro:property name='PI_2' value='1.5707963267948966' />
  <xacro:arg name="robot_name" default="X" />


  <!-- Define the macro for the whole shelfino -->
  <xacro:macro name="shelfino" params='robot_name'>


    <xacro:if value="${robot_name != 'X'}">
        <xacro:property name="robot_name_slash" value="'${robot_name}/'" />
    </xacro:if>
    <xacro:unless value="${robot_name == 'X'}">
        <xacro:property name="robot_name_slash" value="''" />
    </xacro:unless>
    <xacro:property name="robot_name_slash" value="${robot_name != 'X'}? '' : 'pollo'" />


      <xacro:include filename='shelfino_test/materials.xacro' />

      <xacro:include filename='shelfino_test/shelfino_body.xacro' />
      <xacro:include filename='shelfino_test/lidar.xacro' />
      <xacro:include filename='shelfino_test/frontal_camera.xacro' />

      <xacro:include filename='shelfino_test/wheels.xacro' />

      <xacro:include filename='shelfino_test/gazebo_classic_controls.xacro' />
      <!-- <xacro:include filename='shelfino_test/gazebo_controls.xacro' /> -->

      <!-- <xacro:include filename='shelfino_test/xmas_hat.xacro' /> -->

  </xacro:macro>

  <!-- Instantiate the model -->
  <xacro:shelfino robot_name="$(arg robot_name)" />
</robot>
